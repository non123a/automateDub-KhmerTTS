      "notes": null
    },
    {
      "id": 79,
      "start": 162.36,
      "end": 165.52,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你最喜欢的食物是什么",
      "target_text": "ម្ហូបដែលអ្នកចូលចិត្តជាងគេជាអ្វី?",
      "notes": null
    },
    {
      "id": 80,
      "start": 165.52,
      "end": 167.8,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "除了那些甜食以外",
      "target_text": "ក្រៅពីរបស់ផ្អែមទាំងនោះទៅ",
