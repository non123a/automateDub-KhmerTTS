      "source_language": "zh",
      "target_language": "km",
      "source_text": "嗨 欢迎到\"Better in Chinese Street Talk\"",
      "target_text": "សួស្តី សូមស្វាគមន៍មកកាន់ \"Better in Chinese Street Talk\"",
      "notes": null
    },
    {
      "id": 2,
      "start": 7.14,
      "end": 9.12,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "今天我们在中国",
      "target_text": "ថ្ងៃនេះ ពួកយើងនៅប្រទេសចិន",
      "notes": null
    },
    {
      "id": 3,
      "start": 9.12,
      "end": 11.12,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "和我们讨论一些人在街上",
      "target_text": "មកជជែកជាមួយមនុស្សមួយចំនួនតាមផ្លូវ",
      "notes": null
    },
    {
      "id": 4,
      "start": 11.12,
      "end": 12.24,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "在他们的日常生活中",
      "target_text": "អំពីជីវិតប្រចាំថ្ងៃរបស់ពួកគេ",
      "notes": null
    },
    {
      "id": 5,
      "start": 12.24,
      "end": 14.42,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "想不想改善你们的听课吗",
      "target_text": "ចង់បង្កើនសមត្ថភាពស្តាប់របស់អ្នកទេ?",
      "notes": null
    },
    {
      "id": 6,
      "start": 14.42,
      "end": 15.42,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我们去吧",
      "target_text": "តោះ យើងទៅกัน!",
      "notes": null
    },
    {
      "id": 7,
      "start": 15.42,
      "end": 17.92,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你好",
      "target_text": "សួស្តី",
      "notes": null
    },
    {
      "id": 8,
      "start": 17.92,
      "end": 19.0,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你好",
      "target_text": "សួស្តី",
      "notes": null
    },
    {
      "id": 9,
      "start": 19.0,
      "end": 20.5,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你姓什么",
      "target_text": "អ្នកនាមត្រកូលអ្វី?",
      "notes": null
    },
    {
      "id": 10,
      "start": 20.5,
      "end": 21.86,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我姓高",
      "target_text": "ខ្ញុំនាមត្រកូល កៅ",
      "notes": null
    },
    {
      "id": 11,
      "start": 21.86,
      "end": 23.32,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "高小姐 你好",
      "target_text": "កញ្ញាកៅ សួស្តី",
      "notes": null
    },
    {
      "id": 12,
      "start": 23.32,
      "end": 26.02,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "请问你今年芳琳",
      "target_text": "សូមសួរ ឆ្នាំនេះអ្នកអាយុប៉ុន្មានហើយ?",
      "notes": null
    },
    {
      "id": 13,
      "start": 26.02,
      "end": 27.56,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "二十一",
      "target_text": "ម្ភៃមួយ",
      "notes": null
    },
    {
      "id": 14,
      "start": 27.56,
      "end": 28.96,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你是已经工作了",
      "target_text": "អ៊ីចឹង អ្នកចាប់ផ្តើមធ្វើការហើយ",
      "notes": null
    },
    {
      "id": 15,
      "start": 28.96,
      "end": 30.16,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "还是还在上学",
      "target_text": "ឬក៏នៅរៀននៅឡើយ?",
      "notes": null
    },
    {
      "id": 16,
      "start": 30.16,
      "end": 32.36,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "刚毕业还没有找工作",
      "target_text": "ទើបតែបញ្ចប់ការសិក្សា នៅមិនទាន់រកការងារទេ",
      "notes": null
    },
    {
      "id": 17,
      "start": 32.36,
      "end": 34.76,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你大学学的专业是什么",
      "target_text": "ចុះនៅសាកលវិទ្យាល័យ អ្នករៀនជំនាញអ្វី?",
      "notes": null
    },
    {
      "id": 18,
      "start": 34.76,
      "end": 36.6,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "学的是学前教育",
      "target_text": "ខ្ញុំរៀនជំនាញអប់រំកុមារតូច",
      "notes": null
    },
    {
      "id": 19,
      "start": 36.6,
      "end": 37.4,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "学前教育",
      "target_text": "អប់រំកុមារតូច?",
      "notes": null
    },
    {
      "id": 20,
      "start": 37.4,
      "end": 39.84,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那以后是想做老师吗",
      "target_text": "អ៊ីចឹងថ្ងៃក្រោយ ចង់ធ្វើជាគ្រូមែនទេ?",
      "notes": null
    },
    {
      "id": 21,
      "start": 39.84,
      "end": 41.9,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "也有可能会改行",
      "target_text": "ក៏អាចប្តូរទៅធ្វើការផ្សេងដែរ។",
      "notes": null
    },
    {
      "id": 22,
      "start": 41.9,
      "end": 44.98,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你喜欢你的专业吗",
      "target_text": "ចុះអ្នកចូលចិត្តជំនាញដែលរៀនទេ?",
      "notes": null
    },
    {
      "id": 23,
      "start": 44.98,
      "end": 46.0,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我觉得挺喜欢的",
      "target_text": "ខ្ញុំគិតថាចូលចិត្តគួរសមដែរ។",
      "notes": null
    },
    {
      "id": 24,
      "start": 46.0,
      "end": 47.34,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "但是目前的话",
      "target_text": "តែបើនិយាយពីពេលនេះវិញ",
      "notes": null
    },
    {
      "id": 25,
      "start": 47.34,
      "end": 50.34,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "没有想做这个专业的想法",
      "target_text": "ខ្ញុំមិនទាន់មានគំនិតចង់ធ្វើការតាមជំនាញនេះទេ។",
      "notes": null
    },
    {
      "id": 26,
      "start": 50.34,
      "end": 51.92,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你以后工作的话",
      "target_text": "ចុះបើថ្ងៃក្រោយធ្វើការ",
      "notes": null
    },
    {
      "id": 27,
      "start": 51.92,
      "end": 54.68,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "是想从什么行业",
      "target_text": "អ្នកចង់ចូលវិស័យអ្វី?",
      "notes": null
    },
    {
      "id": 28,
      "start": 54.68,
      "end": 55.68,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我觉得都可以吧",
      "target_text": "ខ្ញុំគិតថាអ្វីក៏បាន吧។",
      "notes": null
    },
    {
      "id": 29,
      "start": 55.68,
      "end": 57.48,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我现在品感觉做什么都可以",
      "target_text": "ឥឡូវនេះខ្ញុំមានអារម្មណ៍ថា ធ្វើអ្វីក៏បាន។",
      "notes": null
    },
    {
      "id": 30,
      "start": 57.48,
      "end": 59.12,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你是哪里人",
      "target_text": "អ្នកជាមនុស្សមកពីណា?",
      "notes": null
    },
    {
      "id": 31,
      "start": 59.12,
      "end": 61.42,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我就是苏州本地人",
      "target_text": "ខ្ញុំជាមនុស្សស៊ូចូវដើមកំណើត។",
      "notes": null
    },
    {
      "id": 32,
      "start": 61.42,
      "end": 65.46,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你中国最喜欢的城市是哪个",
      "target_text": "ចុះនៅចិន អ្នកចូលចិត្តទីក្រុងណាជាងគេ?",
      "notes": null
    },
    {
      "id": 33,
      "start": 65.46,
      "end": 68.46,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我觉得我最喜欢的就是苏州",
      "target_text": "ខ្ញុំគិតថាខ្ញុំចូលចិត្តស៊ូចូវជាងគេ។",
      "notes": null
    },
    {
      "id": 34,
      "start": 68.46,
      "end": 69.66,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "为什么",
      "target_text": "ហេតុអ្វី?",
      "notes": null
    },
    {
      "id": 35,
      "start": 69.66,
      "end": 72.34,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "因为这里是生活养我的地方",
      "target_text": "ព្រោះទីនេះជាកន្លែងដែលចិញ្ចឹមខ្ញុំឲ្យធំឡើង។",
      "notes": null
    },
    {
      "id": 36,
      "start": 72.34,
      "end": 73.38,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我觉得很美",
      "target_text": "ខ្ញុំគិតថាវាស្អាតណាស់។",
      "notes": null
    },
    {
      "id": 37,
      "start": 73.38,
      "end": 74.5,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "也是圆林之城",
      "target_text": "ហើយក៏ជាទីក្រុងសួនច្បារផងដែរ។",
      "notes": null
    },
    {
      "id": 38,
      "start": 74.5,
      "end": 77.74,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你会说英语吗",
      "target_text": "ចុះអ្នកចេះនិយាយអង់គ្លេសទេ?",
      "notes": null
    },
    {
      "id": 39,
      "start": 77.74,
      "end": 79.38,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我说的不太好",
      "target_text": "ខ្ញុំនិយាយមិនសូវល្អទេ។",
      "notes": null
    },
    {
      "id": 40,
      "start": 79.38,
      "end": 81.98,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "说的不太好",
      "target_text": "និយាយមិនសូវល្អទេ។",
      "notes": null
    },
    {
      "id": 41,
      "start": 81.98,
      "end": 82.48,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "没事",
      "target_text": "មិនអីទេ។",
      "notes": null
    },
    {
      "id": 42,
      "start": 82.48,
      "end": 84.18,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你除了英语还会说什么",
      "target_text": "អ៊ីចឹងក្រៅពីអង់គ្លេស អ្នកចេះនិយាយអ្វីទៀត?",
      "notes": null
    },
    {
      "id": 43,
      "start": 84.18,
      "end": 86.28,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "别的外语吗",
      "target_text": "ភាសាបរទេសផ្សេងទៀតឬ?",
      "notes": null
    },
    {
      "id": 44,
      "start": 86.28,
      "end": 88.04,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我其他的像日语什么",
      "target_text": "ភាសាផ្សេងៗ ដូចជាជប៉ុនអីហ្នឹង",
      "notes": null
    },
    {
      "id": 45,
      "start": 88.04,
      "end": 89.98,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我都只会一点我不精通",
      "target_text": "ខ្ញុំចេះតែបន្តិចៗ មិនស្ទាត់ទេ។",
      "notes": null
    },
    {
      "id": 46,
      "start": 89.98,
      "end": 92.26,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "都不能打到完全跟外国人",
      "target_text": "មិនទាន់ដល់កម្រិតអាចនិយាយជាមួយជនបរទេស",
      "notes": null
    },
    {
      "id": 47,
      "start": 92.26,
      "end": 94.18,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "就是交流的水平",
      "target_text": "បានស្រួលៗនោះទេ។",
      "notes": null
    },
    {
      "id": 48,
      "start": 94.18,
      "end": 96.36,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那已经超越了很多人了",
      "target_text": "ប៉ុណ្ណឹងក៏លើសមនុស្សច្រើនហើយ។",
      "notes": null
    },
    {
      "id": 49,
      "start": 96.36,
      "end": 97.86,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "其他很多人都不会",
      "target_text": "មនុស្សជាច្រើនទៀតមិនចេះផង។",
      "notes": null
    },
    {
      "id": 50,
      "start": 97.86,
      "end": 99.46,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你有多高",
      "target_text": "អ្នកកម្ពស់ប៉ុន្មាន?",
      "notes": null
    },
    {
      "id": 51,
      "start": 99.46,
      "end": 100.56,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我163",
      "target_text": "ខ្ញុំ១៦៣។",
      "notes": null
    },
    {
      "id": 52,
      "start": 100.56,
      "end": 102.46,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你有兄弟姐妹吗",
      "target_text": "អ្នកមានបងប្អូនទេ?",
      "notes": null
    },
    {
      "id": 53,
      "start": 102.46,
      "end": 104.0,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我是独生女",
      "target_text": "ខ្ញុំជាកូនស្រីតែម្នាក់។",
      "notes": null
    },
    {
      "id": 54,
      "start": 104.0,
      "end": 106.54,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你最喜欢的动物是什么",
      "target_text": "សត្វដែលអ្នកចូលចិត្តបំផុតជាអ្វី?",
      "notes": null
    },
    {
      "id": 55,
      "start": 106.54,
      "end": 108.76,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我喜欢小狗小兔子",
      "target_text": "ខ្ញុំចូលចិត្តកូនឆ្កែ និងកូនទន្សាយ។",
      "notes": null
    },
    {
      "id": 56,
      "start": 108.76,
      "end": 111.68,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你有养这些小动物吗",
      "target_text": "អ៊ីចឹងអ្នកមានចិញ្ចឹមសត្វតូចៗទាំងនេះទេ?",
      "notes": null
    },
