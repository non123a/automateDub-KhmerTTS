      "source_language": "zh",
      "target_language": "km",
      "source_text": "好健康 特别好",
      "target_text": "សុខភាពល្អណាស់ ល្អពិតៗ",
      "notes": null
    },
    {
      "id": 48,
      "start": 105.96,
      "end": 108.72,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你喜欢运动吗",
      "target_text": "ចុះអ្នកចូលចិត្តហាត់ប្រាណទេ?",
      "notes": null
    },
    {
      "id": 49,
      "start": 108.72,
      "end": 110.12,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我不喜欢运动",
      "target_text": "ខ្ញុំមិនចូលចិត្តហាត់ប្រាណទេ",
      "notes": null
    },
    {
