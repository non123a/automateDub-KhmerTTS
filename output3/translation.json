      "id": 93,
      "start": 189.58,
      "end": 191.02,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我最近睡的比较早",
      "target_text": "ថ្មីៗនេះ ខ្ញុំចូលគេងលឿនជាងមុន",
