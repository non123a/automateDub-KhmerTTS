    },
    {
      "id": 27,
      "start": 64.32,
      "end": 65.4,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我喜欢喝奶茶",
      "target_text": "ខ្ញុំចូលចិត្តផឹកតែទឹកដោះគោ។",
