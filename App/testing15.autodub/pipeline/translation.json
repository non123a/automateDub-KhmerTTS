      "source_language": "zh",
      "target_language": "km",
      "source_text": "都不能达到完全跟外国人交流的水平",
      "target_text": "ក៏នៅមិនទាន់ដល់កម្រិតអាចនិយាយជាមួយជនបរទេសបានពេញលេញទេ",
      "notes": null
    },
    {
      "id": 1,
      "start": 4.08,
      "end": 6.4,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那已经超越了很多人了",
      "target_text": "តែប៉ុណ្ណឹងក៏លើសមនុស្សជាច្រើនហើយ",
      "notes": null
    },
    {
      "id": 2,
      "start": 6.4,
      "end": 7.8,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "其他很多人都不会",
      "target_text": "មនុស្សជាច្រើនទៀតនៅមិនចេះផង",
      "notes": null
    },
    {
      "id": 3,
      "start": 7.8,
      "end": 9.36,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你有多高",
      "target_text": "អ្នកខ្ពស់ប៉ុន្មាន?",
      "notes": null
    },
    {
      "id": 4,
      "start": 9.36,
      "end": 10.44,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我163",
      "target_text": "ខ្ញុំមួយរយហុកសិបបី",
      "notes": null
    },
    {
      "id": 5,
      "start": 10.44,
      "end": 12.36,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你有兄弟姐妹吗",
      "target_text": "អ្នកមានបងប្អូនទេ?",
      "notes": null
    },
    {
      "id": 6,
      "start": 12.36,
      "end": 13.92,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我是独生女",
      "target_text": "ខ្ញុំជាកូនស្រីតែម្នាក់",
      "notes": null
    },
    {
      "id": 7,
      "start": 13.92,
      "end": 16.44,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你最喜欢的动物是什么",
      "target_text": "សត្វដែលអ្នកចូលចិត្តជាងគេជាអ្វី?",
      "notes": null
    },
    {
      "id": 8,
      "start": 16.44,
      "end": 18.68,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我喜欢小狗小兔子",
      "target_text": "ខ្ញុំចូលចិត្តកូនឆ្កែ និងកូនទន្សាយ",
      "notes": null
    },
    {
      "id": 9,
      "start": 18.68,
      "end": 21.6,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你有养这些小动物吗",
      "target_text": "អ៊ីចឹងអ្នកមានចិញ្ចឹមសត្វតូចៗទាំងនេះទេ?",
      "notes": null
    },
    {
      "id": 10,
      "start": 21.6,
      "end": 22.92,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "以前养过小兔子",
      "target_text": "ពីមុនធ្លាប់ចិញ្ចឹមកូនទន្សាយ",
      "notes": null
    },
    {
      "id": 11,
      "start": 22.92,
      "end": 24.8,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "然后现在不养了",
      "target_text": "តែឥឡូវមិនចិញ្ចឹមទៀតទេ",
      "notes": null
    },
    {
      "id": 12,
      "start": 24.8,
      "end": 27.72,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你以后还会想要养这些小兔子",
      "target_text": "អ៊ីចឹងទៅថ្ងៃក្រោយ អ្នកនៅចង់ចិញ្ចឹមកូនទន្សាយទាំងនេះទៀតទេ?",
      "notes": null
    },
    {
      "id": 13,
      "start": 27.72,
      "end": 29.04,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "或者小狗之类的吗",
      "target_text": "ឬក៏កូនឆ្កែអីបែបនោះ?",
      "notes": null
    },
    {
      "id": 14,
      "start": 29.04,
      "end": 32.64,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我以后还会养小狗小猫这些小动物",
      "target_text": "ថ្ងៃក្រោយខ្ញុំនឹងចិញ្ចឹមកូនឆ្កែ កូនឆ្មា សត្វតូចៗបែបនេះ",
      "notes": null
    },
    {
      "id": 15,
      "start": 32.64,
      "end": 34.68,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你最喜欢的国家是哪个",
      "target_text": "ប្រទេសណាដែលអ្នកចូលចិត្តជាងគេ?",
      "notes": null
    },
    {
      "id": 16,
      "start": 34.68,
      "end": 36.28,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "除了中国",
      "target_text": "ក្រៅពីចិនนะ",
      "notes": null
    },
    {
      "id": 17,
      "start": 36.28,
      "end": 40.76,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我喜欢瑞士",
      "target_text": "ខ្ញុំចូលចិត្តស្វីស",
      "notes": null
    },
    {
      "id": 18,
      "start": 40.76,
      "end": 43.04,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你有没有去过瑞士",
