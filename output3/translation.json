      "notes": null
    },
    {
      "id": 75,
      "start": 154.48,
      "end": 155.52,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我喜欢喝奶茶",
      "target_text": "ខ្ញុំចូលចិត្តផឹកតែទឹកដោះគោ។",
      "notes": null
    },
    {
      "id": 76,
      "start": 155.52,
      "end": 158.72,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "所有的饮料甜的东西我都喜欢吃",
