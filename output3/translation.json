    },
    {
      "id": 98,
      "start": 198.9,
      "end": 200.52,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我不喜欢运动",
      "target_text": "ខ្ញុំមិនចូលចិត្តហាត់ប្រាណទេ",
      "notes": null
    },
    {
      "id": 99,
      "start": 200.52,
      "end": 204.06,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你平时就刷手机",
      "target_text": "អញ្ចឹងធម្មតា អ្នកគ្រាន់តែអូសទូរស័ព្ទមើល?",
      "notes": null
    },
    {
      "id": 100,
      "start": 204.06,
      "end": 206.32,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "对 我平时就是喜欢烫着",
      "target_text": "ចាស ធម្មតាខ្ញុំចូលចិត្តដេកសម្រាក",
      "notes": null
    },
    {
      "id": 101,
      "start": 206.32,
      "end": 207.56,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "刷手机",
      "target_text": "អូសមើលទូរស័ព្ទ។",
      "notes": null
    },
    {
      "id": 102,
      "start": 207.56,
      "end": 208.8,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "好",
      "target_text": "បាន។",
      "notes": null
    },
    {
      "id": 103,
      "start": 208.8,
      "end": 211.16,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你每天早上起来的第一件事",
      "target_text": "អ៊ីចឹង រឿងដំបូងដែលអ្នកធ្វើពេលភ្ញាក់ពីព្រឹករាល់ថ្ងៃ",
      "notes": null
    },
    {
      "id": 104,
      "start": 211.16,
      "end": 213.7,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "是做什么",
      "target_text": "គឺធ្វើអ្វី?",
      "notes": null
    },
    {
      "id": 105,
      "start": 213.7,
      "end": 216.34,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "打开手机 看手机",
      "target_text": "បើកទូរស័ព្ទ មើលទូរស័ព្ទ។",
      "notes": null
    },
    {
      "id": 106,
      "start": 216.34,
      "end": 218.44,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "好 新鲜人类",
      "target_text": "បាន មនុស្សសម័យថ្មី។",
      "notes": null
    },
    {
      "id": 107,
      "start": 218.44,
      "end": 221.34,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你好",
      "target_text": "សួស្តី។",
      "notes": null
    },
    {
      "id": 108,
      "start": 221.34,
      "end": 222.52,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你好",
      "target_text": "សួស្តី។",
      "notes": null
    },
    {
      "id": 109,
      "start": 222.52,
      "end": 223.98,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你姓什么",
      "target_text": "អ្នកនាមត្រកូលអ្វី?",
