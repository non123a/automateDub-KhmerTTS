    {
      "id": 110,
      "start": 223.98,
      "end": 225.12,
      "text": "我姓高"
    },
    {
      "id": 111,
      "start": 225.12,
      "end": 226.48,
      "text": "高小姐 你好"
    },
    {
      "id": 112,
      "start": 226.48,
      "end": 229.76,
      "text": "请问你今年方菱"
    },
    {
      "id": 113,
      "start": 229.76,
      "end": 230.72,
      "text": "21"
    },
    {
      "id": 114,
      "start": 230.72,
      "end": 233.26,
      "text": "那你是已经工作了还是还在上学"
    },
    {
      "id": 115,
      "start": 233.26,
      "end": 235.42,
      "text": "刚毕业还没有找工作"
    },
    {
      "id": 116,
      "start": 235.42,
      "end": 237.76,
      "text": "那你大学学的专业是什么"
    },
    {
      "id": 117,
      "start": 237.76,
      "end": 239.7,
      "text": "学的是学前教育"
    },
    {
      "id": 118,
      "start": 239.7,
      "end": 240.5,
      "text": "学前教育"
    },
    {
      "id": 119,
      "start": 240.5,
      "end": 242.84,
      "text": "那以后是想做老师吗"
    },
    {
      "id": 120,
      "start": 242.84,
      "end": 245.0,
      "text": "也有可能会改行"
    },
    {
      "id": 121,
      "start": 245.0,
      "end": 248.04,
      "text": "那你喜欢你的专业吗"
    },
    {
      "id": 122,
      "start": 248.04,
      "end": 249.1,
      "text": "我觉得挺喜欢的"
    },
    {
      "id": 123,
      "start": 249.1,
      "end": 250.44,
      "text": "但是目前的话"
    },
    {
      "id": 124,
      "start": 250.44,
      "end": 253.38,
      "text": "没有想做这个专业的想法"
    },
    {
      "id": 125,
      "start": 253.38,
      "end": 255.02,
      "text": "那你以后工作的话"
    },
    {
      "id": 126,
      "start": 255.02,
      "end": 257.78,
      "text": "是想从事什么行业"
    },
    {
      "id": 127,
      "start": 257.78,
      "end": 258.78,
      "text": "我觉得都可以吧"
    },
    {
      "id": 128,
      "start": 258.78,
      "end": 260.62,
      "text": "我现在品感觉做什么都可以"
    },
    {
      "id": 129,
      "start": 260.62,
      "end": 262.26,
      "text": "你是哪里人"
    },
    {
      "id": 130,
      "start": 262.26,
      "end": 264.56,
      "text": "我就是苏州本地人"
    },
    {
      "id": 131,
      "start": 264.56,
      "end": 268.62,
      "text": "那你中国最喜欢的城市是哪个"
    },
    {
      "id": 132,
      "start": 268.62,
      "end": 271.6,
      "text": "我觉得我最喜欢的就是苏州"
    },
    {
      "id": 133,
      "start": 271.6,
      "end": 272.8,
      "text": "为什么"
    },
    {
      "id": 134,
      "start": 272.8,
      "end": 275.5,
      "text": "因为这里是生活养我的地方"
    },
    {
      "id": 135,
      "start": 275.5,
      "end": 276.54,
      "text": "我觉得很美"
    },
    {
      "id": 136,
      "start": 276.54,
      "end": 277.64,
      "text": "也是圆灵之城"
    },
    {
      "id": 137,
      "start": 277.64,
      "end": 280.94,
      "text": "那你会说英语吗"
    },
    {
      "id": 138,
      "start": 280.94,
      "end": 282.54,
      "text": "我说的不太好"
    },
    {
      "id": 139,
      "start": 282.54,
      "end": 285.18,
      "text": "说的不太好"
    },
    {
      "id": 140,
      "start": 285.18,
      "end": 285.64,
      "text": "没事"
    },
    {
      "id": 141,
      "start": 285.64,
      "end": 286.54,
      "text": "那你除了英语"
    },
    {
      "id": 142,
      "start": 286.54,
      "end": 289.42,
      "text": "还会说什么别的外语吗"
    },
    {
      "id": 143,
      "start": 289.42,
      "end": 291.28,
      "text": "我其他的像日语什么"
    },
    {
      "id": 144,
      "start": 291.28,
      "end": 293.16,
      "text": "我都只会一点我不精通"
    },
    {
      "id": 145,
      "start": 293.16,
      "end": 295.42,
      "text": "都不能打到完全跟外国人"
    },
    {
      "id": 146,
      "start": 295.42,
      "end": 297.36,
      "text": "就是交流的水平"
    },
    {
      "id": 147,
      "start": 297.36,
      "end": 299.56,
      "text": "那已经超越了很多人了"
    },
    {
      "id": 148,
      "start": 299.56,
      "end": 301.06,
      "text": "其他很多人都不会"
    },
    {
      "id": 149,
      "start": 301.06,
      "end": 302.66,
      "text": "你有多高"
    },
    {
      "id": 150,
      "start": 302.66,
      "end": 303.76,
      "text": "我163"
    },
    {
      "id": 151,
      "start": 303.76,
      "end": 305.66,
      "text": "你有兄弟姐妹吗"
    },
    {
      "id": 152,
      "start": 305.66,
      "end": 307.2,
      "text": "我是独生女"
    },
    {
      "id": 153,
      "start": 307.2,
      "end": 309.74,
      "text": "你最喜欢的动物是什么"
    },
    {
      "id": 154,
      "start": 309.74,
      "end": 311.96,
      "text": "我喜欢小狗 小兔子"
    },
    {
      "id": 155,
      "start": 311.96,
      "end": 314.88,
      "text": "那你有养这些小动物吗"
    },
    {
      "id": 156,
      "start": 314.88,
      "end": 316.14,
      "text": "以前养过小兔子"
    },
    {
      "id": 157,
      "start": 316.14,
      "end": 318.04,
      "text": "然后现在不养了"
    },
    {
      "id": 158,
      "start": 318.04,
      "end": 320.44,
      "text": "那你以后还会想要养这些"
    },
    {
      "id": 159,
      "start": 320.44,
      "end": 322.28,
      "text": "小兔子或者小狗之类的吗"
    },
    {
      "id": 160,
      "start": 322.28,
      "end": 324.12,
      "text": "我以后还会养小狗"
    },
    {
      "id": 161,
      "start": 324.12,
      "end": 325.92,
      "text": "小猫这些小动物"
    },
    {
      "id": 162,
      "start": 325.92,
      "end": 327.92,
      "text": "你最喜欢的国家是哪个"
    },
    {
      "id": 163,
      "start": 327.92,
      "end": 330.86,
      "text": "除了中国"
    },
    {
      "id": 164,
      "start": 330.86,
      "end": 334.4,
      "text": "我喜欢瑞士"
    },
    {
      "id": 165,
      "start": 334.4,
      "end": 336.32,
      "text": "那你有没有去过瑞士"
    },
    {
      "id": 166,
      "start": 336.32,
      "end": 338.0,
      "text": "暂时还没有去过"
    },
    {
      "id": 167,
      "start": 338.0,
      "end": 340.74,
      "text": "那你去过哪些国家"
    },
    {
      "id": 168,
      "start": 340.74,
      "end": 342.84,
      "text": "我目前没有出过国"
    },
    {
      "id": 169,
      "start": 342.84,
      "end": 345.6,
      "text": "那你的爱好是什么"
    },
    {
      "id": 170,
      "start": 345.6,
      "end": 348.0,
      "text": "我的爱好就是刷手机"
    },
    {
      "id": 171,
      "start": 348.0,
      "end": 353.58,
      "text": "你最喜欢的水果是什么"
    },
    {
      "id": 172,
      "start": 353.58,
      "end": 355.28,
      "text": "我喜欢吃草莓"
    },
    {
      "id": 173,
      "start": 355.28,
      "end": 357.62,
      "text": "那你喜欢喝饮料吗"
    },
    {
      "id": 174,
      "start": 357.62,
      "end": 358.72,
      "text": "我喜欢喝奶茶"
    },
    {
      "id": 175,
      "start": 358.72,
      "end": 361.88,
      "text": "所有的饮料 甜的东西我都喜欢吃"
    },
    {
      "id": 176,
      "start": 361.88,
      "end": 365.52,
      "text": "很有品味 我也喜欢吃甜的"
    },
    {
      "id": 177,
      "start": 365.52,
      "end": 368.6,
      "text": "你最喜欢的食物是什么"
    },
    {
      "id": 178,
      "start": 368.6,
      "end": 370.96,
      "text": "除了那些甜食以外"
    },
    {
      "id": 179,
      "start": 370.96,
      "end": 372.76,
      "text": "我喜欢吃意大利面"
    },
    {
      "id": 180,
      "start": 372.76,
      "end": 374.7,
      "text": "那是很好吃"
    },
    {
      "id": 181,
      "start": 374.7,
      "end": 377.34,
      "text": "你每天几点起床"
    },
    {
      "id": 182,
      "start": 377.34,
      "end": 378.24,
      "text": "我最近的话"
    },
    {
      "id": 183,
      "start": 378.24,
      "end": 380.5,
      "text": "天天早上六点钟就起床了"
    },
    {
      "id": 184,
      "start": 380.5,
      "end": 381.8,
      "text": "那么早"
    },
    {
      "id": 185,
      "start": 381.8,
      "end": 383.18,
      "text": "是要上课吗"
    },
    {
      "id": 186,
      "start": 383.18,
      "end": 383.94,
      "text": "没有"
    },
    {
      "id": 187,
      "start": 383.94,
      "end": 385.84,
      "text": "就是想让自己早点起来"
    },
    {
      "id": 188,
      "start": 385.84,
      "end": 388.04,
      "text": "不要就是睡到中午"
    },
    {
      "id": 189,
      "start": 388.04,
      "end": 389.48,
      "text": "哇 那很有意义"
    },
    {
      "id": 190,
      "start": 389.48,
      "end": 392.72,
      "text": "那你每天什么时候睡觉"
    },
    {
      "id": 191,
      "start": 392.72,
      "end": 394.18,
      "text": "我最近睡的比较早"
    },
    {
      "id": 192,
      "start": 394.18,
      "end": 396.82,
      "text": "大概晚上十点十一点就睡了"
    },
    {
      "id": 193,
      "start": 396.82,
      "end": 398.32,
      "text": "哇 好健康"
    },
    {
      "id": 194,
      "start": 398.32,
      "end": 399.76,
      "text": "特别好"
    },
    {
      "id": 195,
      "start": 399.76,
      "end": 402.06,
      "text": "那你喜欢运动吗"
    },
    {
      "id": 196,
      "start": 402.06,
      "end": 403.6,
      "text": "我不喜欢运动"
    },
    {
      "id": 197,
      "start": 403.6,
      "end": 407.22,
      "text": "那你平时就刷手机"
    },
    {
      "id": 198,
      "start": 407.22,
      "end": 409.4,
      "text": "对 我平时就是喜欢烫着"
    },
    {
      "id": 199,
      "start": 409.4,
      "end": 410.66,
      "text": "刷手机"
    },
    {
      "id": 200,
      "start": 410.66,
      "end": 411.94,
      "text": "好"
    },
    {
      "id": 201,
      "start": 411.94,
      "end": 416.8,
      "text": "那你每天早上起来的第一件事是做什么"
    },
    {
      "id": 202,
      "start": 416.8,
      "end": 419.48,
      "text": "打开手机 看手机"
    },
    {
      "id": 203,
      "start": 419.48,
      "end": 421.54,
      "text": "好 星星人类"
    },
    {
      "id": 204,
      "start": 433.6,
      "end": 435.6,
      "text": "(字幕:貝爾)"
    }
  ]
}
