    },
    {
      "id": 110,
      "start": 223.98,
      "end": 225.12,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我姓高",
      "target_text": "ខ្ញុំនាមត្រកូល កាវ។",
      "notes": null
    },
    {
      "id": 111,
      "start": 225.12,
      "end": 226.48,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "高小姐 你好",
      "target_text": "កញ្ញាកាវ សួស្តី។",
      "notes": null
    },
    {
      "id": 112,
      "start": 226.48,
      "end": 229.76,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "请问你今年方菱",
      "target_text": "សុំសួរ ឆ្នាំនេះអ្នកអាយុប៉ុន្មាន?",
      "notes": null
    },
    {
      "id": 113,
      "start": 229.76,
      "end": 230.72,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "21",
