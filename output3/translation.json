      "id": 96,
      "start": 195.16,
      "end": 196.58,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "特别好",
      "target_text": "ល្អខ្លាំងមែន",
      "notes": null
    },
    {
      "id": 97,
      "start": 196.58,
      "end": 198.9,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你喜欢运动吗",
      "target_text": "ចុះអ្នកចូលចិត្តហាត់ប្រាណទេ?",
