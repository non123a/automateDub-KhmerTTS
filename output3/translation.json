    {
      "id": 168,
      "start": 340.74,
      "end": 342.84,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我目前没有出过国",
      "target_text": "មកទល់ពេលនេះ ខ្ញុំមិនទាន់ធ្លាប់ចេញក្រៅប្រទេសទេ",
      "notes": null
    },
    {
      "id": 169,
      "start": 342.84,
      "end": 345.6,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你的爱好是什么",
      "target_text": "អ៊ីចឹង ចំណូលចិត្តរបស់អ្នកជាអ្វី?",
      "notes": null
    },
    {
      "id": 170,
      "start": 345.6,
      "end": 348.0,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我的爱好就是刷手机",
      "target_text": "ចំណូលចិត្តខ្ញុំ គឺអូសមើលទូរស័ព្ទ",
      "notes": null
    },
    {
      "id": 171,
      "start": 348.0,
      "end": 353.58,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你最喜欢的水果是什么",
      "target_text": "ផ្លែឈើដែលអ្នកចូលចិត្តជាងគេជាអ្វី?",
      "notes": null
    },
    {
      "id": 172,
      "start": 353.58,
      "end": 355.28,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我喜欢吃草莓",
      "target_text": "ខ្ញុំចូលចិត្តញ៉ាំស្ត្របឺរី",
      "notes": null
    },
    {
      "id": 173,
      "start": 355.28,
      "end": 357.62,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你喜欢喝饮料吗",
      "target_text": "អ៊ីចឹង អ្នកចូលចិត្តផឹកភេសជ្ជៈទេ?",
      "notes": null
    },
    {
      "id": 174,
      "start": 357.62,
      "end": 358.72,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我喜欢喝奶茶",
      "target_text": "ខ្ញុំចូលចិត្តផឹកតែទឹកដោះគោ",
      "notes": null
    },
    {
      "id": 175,
      "start": 358.72,
      "end": 361.88,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "所有的饮料 甜的东西我都喜欢吃",
      "target_text": "ភេសជ្ជៈទាំងអស់ អ្វីដែលផ្អែមៗ ខ្ញុំចូលចិត្តទាំងអស់",
      "notes": null
    },
    {
      "id": 176,
      "start": 361.88,
      "end": 365.52,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "很有品味 我也喜欢吃甜的",
      "target_text": "មានរសជាតិល្អណាស់ ខ្ញុំក៏ចូលចិត្តញ៉ាំផ្អែមដែរ",
      "notes": null
    },
    {
      "id": 177,
      "start": 365.52,
      "end": 368.6,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你最喜欢的食物是什么",
      "target_text": "ម្ហូបដែលអ្នកចូលចិត្តជាងគេជាអ្វី?",
      "notes": null
    },
    {
      "id": 178,
      "start": 368.6,
      "end": 370.96,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "除了那些甜食以外",
      "target_text": "ក្រៅពីរបស់ផ្អែមៗទាំងនោះ",
      "notes": null
    },
    {
      "id": 179,
      "start": 370.96,
      "end": 372.76,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我喜欢吃意大利面",
      "target_text": "ខ្ញុំចូលចិត្តញ៉ាំស្ប៉ាហ្គេទី",
      "notes": null
    },
    {
      "id": 180,
      "start": 372.76,
      "end": 374.7,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那是很好吃",
      "target_text": "អាហ្នឹងឆ្ងាញ់ណាស់។",
      "notes": null
    },
    {
      "id": 181,
      "start": 374.7,
      "end": 377.34,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你每天几点起床",
      "target_text": "រាល់ថ្ងៃអ្នកក្រោកម៉ោងប៉ុន្មាន?",
      "notes": null
    },
    {
      "id": 182,
      "start": 377.34,
      "end": 378.24,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我最近的话",
      "target_text": "បើនិយាយពីខ្ញុំថ្មីៗនេះ...",
      "notes": null
    },
    {
      "id": 183,
      "start": 378.24,
      "end": 380.5,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "天天早上六点钟就起床了",
      "target_text": "រាល់ព្រឹកម៉ោងប្រាំមួយ ខ្ញុំក្រោកហើយ។",
      "notes": null
    },
    {
      "id": 184,
      "start": 380.5,
      "end": 381.8,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那么早",
      "target_text": "លឿនម្ល៉េះ?",
      "notes": null
    },
    {
      "id": 185,
      "start": 381.8,
      "end": 383.18,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "是要上课吗",
      "target_text": "ត្រូវទៅរៀនឬ?",
      "notes": null
    },
    {
      "id": 186,
      "start": 383.18,
      "end": 383.94,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "没有",
      "target_text": "អត់ទេ។",
      "notes": null
    },
    {
      "id": 187,
      "start": 383.94,
      "end": 385.84,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "就是想让自己早点起来",
      "target_text": "គ្រាន់តែចង់ឲ្យខ្លួនឯងក្រោកព្រឹកបន្តិច។",
      "notes": null
    },
    {
      "id": 188,
      "start": 385.84,
      "end": 388.04,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "不要就是睡到中午",
      "target_text": "កុំឲ្យដេករហូតដល់ថ្ងៃត្រង់។",
      "notes": null
    },
    {
      "id": 189,
      "start": 388.04,
      "end": 389.48,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "哇 那很有意义",
      "target_text": "វ៉ាវ អញ្ចឹងមានន័យណាស់។",
      "notes": null
    },
    {
      "id": 190,
      "start": 389.48,
      "end": 392.72,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你每天什么时候睡觉",
      "target_text": "ចុះរាល់ថ្ងៃអ្នកចូលគេងពេលណា?",
      "notes": null
    },
    {
      "id": 191,
      "start": 392.72,
      "end": 394.18,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我最近睡的比较早",
      "target_text": "ថ្មីៗនេះ ខ្ញុំចូលគេងលឿនជាងមុន។",
      "notes": null
    },
    {
      "id": 192,
      "start": 394.18,
      "end": 396.82,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "大概晚上十点十一点就睡了",
      "target_text": "ប្រហែលម៉ោងដប់ ឬដប់មួយយប់ ក៏គេងហើយ។",
      "notes": null
    },
    {
      "id": 193,
      "start": 396.82,
      "end": 398.32,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "哇 好健康",
      "target_text": "វ៉ាវ សុខភាពល្អណាស់។",
      "notes": null
    },
    {
      "id": 194,
      "start": 398.32,
      "end": 399.76,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "特别好",
      "target_text": "ល្អមែនទែន។",
      "notes": null
    },
    {
      "id": 195,
      "start": 399.76,
      "end": 402.06,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你喜欢运动吗",
      "target_text": "ចុះអ្នកចូលចិត្តហាត់ប្រាណទេ?",
      "notes": null
    },
    {
      "id": 196,
      "start": 402.06,
      "end": 403.6,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我不喜欢运动",
      "target_text": "ខ្ញុំមិនចូលចិត្តហាត់ប្រាណទេ។",
      "notes": null
    },
    {
      "id": 197,
      "start": 403.6,
      "end": 407.22,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你平时就刷手机",
      "target_text": "អញ្ចឹងធម្មតាអ្នកគ្រាន់តែអូសទូរស័ព្ទ?",
      "notes": null
    },
    {
      "id": 198,
      "start": 407.22,
      "end": 409.4,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "对 我平时就是喜欢烫着",
      "target_text": "បាទ ធម្មតាខ្ញុំចូលចិត្តដេកលេង...",
      "notes": null
    },
    {
      "id": 199,
      "start": 409.4,
      "end": 410.66,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "刷手机",
      "target_text": "អូសទូរស័ព្ទ។",
      "notes": null
    },
    {
      "id": 200,
      "start": 410.66,
      "end": 411.94,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "好",
      "target_text": "បានហើយ",
      "notes": null
    },
    {
      "id": 201,
      "start": 411.94,
      "end": 416.8,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你每天早上起来的第一件事是做什么",
      "target_text": "អ៊ីចឹង រាល់ព្រឹកពេលក្រោកឡើង រឿងដំបូងដែលអ្នកធ្វើគឺអ្វី?",
      "notes": null
    },
    {
      "id": 202,
      "start": 416.8,
      "end": 419.48,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "打开手机 看手机",
      "target_text": "បើកទូរស័ព្ទ មើលទូរស័ព្ទ",
      "notes": null
    },
    {
      "id": 203,
      "start": 419.48,
      "end": 421.54,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "好 星星人类",
      "target_text": "ល្អ មនុស្សផ្កាយ",
      "notes": null
    },
    {
      "id": 204,
      "start": 433.6,
      "end": 435.6,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "(字幕:貝爾)",
      "target_text": "(អក្សរលើអេក្រង់៖ បែល)",
      "notes": null
    }
  ]
}
