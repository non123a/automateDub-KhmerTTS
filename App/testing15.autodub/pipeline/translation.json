      "target_language": "km",
      "source_text": "我目前没有出过国",
      "target_text": "មកទល់ពេលនេះ ខ្ញុំមិនទាន់ធ្លាប់ចេញទៅក្រៅប្រទេសទេ។",
      "notes": null
    },
    {
      "id": 22,
      "start": 49.4,
      "end": 52.32,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你的爱好是什么",
