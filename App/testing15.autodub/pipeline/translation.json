    },
    {
      "id": 28,
      "start": 65.4,
      "end": 68.56,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "所有的饮料 甜的东西我都喜欢吃",
      "target_text": "ភេសជ្ជៈទាំងអស់ ហើយរបស់ផ្អែមៗ ខ្ញុំចូលចិត្តទាំងអស់។",
      "notes": null
    },
    {
      "id": 29,
      "start": 68.56,
      "end": 69.48,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "很有品味",
      "target_text": "រសជាតិល្អណាស់។",
