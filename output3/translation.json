      "notes": null
    },
    {
      "id": 72,
      "start": 144.84,
      "end": 150.42,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你最喜欢的水果是什么",
      "target_text": "ផ្លែឈើដែលអ្នកចូលចិត្តជាងគេជាអ្វី?",
      "notes": null
    },
    {
      "id": 73,
      "start": 150.42,
      "end": 152.18,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我喜欢吃草莓",
      "target_text": "ខ្ញុំចូលចិត្តញ៉ាំស្ត្របឺរី។",
