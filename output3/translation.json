      "id": 89,
      "start": 180.8,
      "end": 182.68,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "就是想让自己早点起来",
      "target_text": "គ្រាន់តែចង់ឲ្យខ្លួនឯងភ្ញាក់ឲ្យលឿនបន្តិច",
      "notes": null
    },
