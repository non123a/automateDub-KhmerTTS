      "end": 54.84,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我的爱好就是刷手机",
      "target_text": "ចំណង់ចំណូលចិត្តខ្ញុំ គឺអូសទូរស័ព្ទលេងហ្នឹងហើយ។",
      "notes": null
    },
    {
      "id": 24,
      "start": 57.84,
      "end": 60.24,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "你最喜欢的水果是什么",
      "target_text": "ផ្លែឈើដែលអ្នកចូលចិត្តបំផុតគឺអ្វី?",
      "notes": null
    },
    {
      "id": 25,
      "start": 60.24,
      "end": 62.0,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我喜欢吃草莓",
      "target_text": "ខ្ញុំចូលចិត្តញ៉ាំស្ត្របឺរី។",
      "notes": null
    },
    {
      "id": 26,
      "start": 62.0,
      "end": 64.32,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你喜欢喝饮料吗",
