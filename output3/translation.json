      "id": 77,
      "start": 158.72,
      "end": 159.62,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "很有品味",
      "target_text": "រសនិយមល្អណាស់។",
      "notes": null
    },
    {
      "id": 78,
      "start": 159.62,
      "end": 162.36,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我也喜欢吃甜的",
