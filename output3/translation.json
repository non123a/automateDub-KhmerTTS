    {
      "id": 68,
      "start": 134.86,
      "end": 137.4,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "那你去过哪些国家",
      "target_text": "អ៊ីចឹងអ្នកធ្លាប់ទៅប្រទេសណាខ្លះ?",
