    },
    {
      "id": 30,
      "start": 69.48,
      "end": 72.2,
      "source_language": "zh",
      "target_language": "km",
      "source_text": "我也喜欢吃甜的",
      "target_text": "ខ្ញុំក៏ចូលចិត្តញ៉ាំរបស់ផ្អែមដែរ។",
